# The same broad static module build is exercised through thirty-five runtime
# personalities. Each installed run_N tree selects exactly one block.

<IfDefine FUZZ_CONFIG_1>
    HttpProtocolOptions Strict RegisteredMethods Require1.0
</IfDefine>

<IfDefine FUZZ_CONFIG_2>
    HttpProtocolOptions Strict LenientMethods Require1.0
    <Location />
        AllowMethods GET HEAD POST OPTIONS
    </Location>
</IfDefine>

<IfDefine FUZZ_CONFIG_3>
    HttpProtocolOptions Unsafe LenientMethods Allow0.9
</IfDefine>

<IfDefine FUZZ_CONFIG_4>
    HttpProtocolOptions Unsafe LenientMethods Require1.0
    LimitRequestBody 65536
    LimitRequestFieldSize 8190
    LimitRequestFields 64
    LimitRequestLine 8190
</IfDefine>

<IfDefine FUZZ_CONFIG_5>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^([^.]+)\.fuzz\.test$ [NC]
    RewriteRule ^/tenant/(.*)$ /rewritten/$1?tenant=%1 [N,E=FUZZ_TENANT:%1]
    RewriteCond %{QUERY_STRING} (^|&)loop=1(&|$)
    RewriteRule ^/rewritten/(.*)$ /final/$1 [END]
    Header always set X-Fuzz-Config "rewrite"
    Header echo X-Fuzz-Input
    SetEnvIfExpr "-n req('Forwarded')" FUZZ_FORWARDED=1
    RemoteIPHeader X-Forwarded-For
</IfDefine>

<IfDefine FUZZ_CONFIG_6>
    AddOutputFilterByType DEFLATE text/plain text/html application/json
    AddOutputFilterByType BROTLI_COMPRESS text/plain text/html application/json
    <Location /inflate>
        SetHandler reflector
        SetInputFilter DEFLATE
        DeflateInflateLimitRequestBody 65536
    </Location>
    <Location /sed>
        SetHandler reflector
        SetInputFilter Sed
        SetOutputFilter Sed
        InputSed "s/fuzz/replaced/g"
        OutputSed "s/replaced/FUZZED/g"
    </Location>
    <Location /substitute>
        SetOutputFilter SUBSTITUTE
        Substitute "s/fuzz/replaced/ni"
    </Location>
    SetEnvIfNoCase Request_URI "\.(?:txt|html)$" no-gzip=!dont-vary
</IfDefine>

<IfDefine FUZZ_CONFIG_7>
    AuthnCacheSOCache shmcb:@RUN_DIR@/logs/authn-cache(65536)
    <Location /auth/basic>
        AuthType Basic
        AuthName "fuzz-basic"
        AuthBasicProvider socache file
        AuthnCacheProvideFor file
        AuthUserFile "@RUN_DIR@/conf/users"
        Require valid-user
    </Location>
    <Location /auth/digest>
        AuthType Digest
        AuthName "fuzz"
        AuthDigestProvider file
        AuthUserFile "@RUN_DIR@/conf/digest-users"
        Require valid-user
    </Location>
    <Location /auth/form>
        AuthType form
        AuthName "/auth/form"
        AuthFormProvider file
        AuthUserFile "@RUN_DIR@/conf/users"
        AuthFormLoginRequiredLocation "/login.html"
        Session On
        SessionCookieName fuzz-session path=/;httponly
        Require valid-user
    </Location>
    <Location /auth/login>
        SetHandler form-login-handler
        AuthType form
        AuthName "/auth/form"
        AuthFormProvider file
        AuthUserFile "@RUN_DIR@/conf/users"
        AuthFormLoginRequiredLocation "/login.html"
        AuthFormLoginSuccessLocation "/auth/form"
        Session On
        SessionCookieName fuzz-session path=/;httponly
    </Location>
</IfDefine>

<IfDefine FUZZ_CONFIG_8>
    DavLockDB "@RUN_DIR@/logs/DavLock"
    Alias /dav "@RUN_DIR@/htdocs/dav"
    <Directory "@RUN_DIR@/htdocs/dav">
        Dav On
        Options Indexes
        AllowOverride All
        Require all granted
    </Directory>
</IfDefine>

<IfDefine FUZZ_CONFIG_9>
    Listen [::1]:@BACKEND_PORT@
    ProxyRequests Off
    ProxyPass /proxy/ http://[::1]:@BACKEND_PORT@/backend/
    ProxyPassReverse /proxy/ http://[::1]:@BACKEND_PORT@/backend/
    <VirtualHost [::1]:@BACKEND_PORT@>
        DocumentRoot "@RUN_DIR@/htdocs"
        SetEnv FUZZ_BACKEND 1
    </VirtualHost>
</IfDefine>

<IfDefine FUZZ_CONFIG_10>
    Listen [::1]:@BACKEND_PORT@
    ProxyRequests On
    AllowCONNECT @BACKEND_PORT@
    <Proxy "*">
        Require expr "%{THE_REQUEST} =~ m#^(?:CONNECT[[:space:]]+[[]::1[]]:@BACKEND_PORT@[[:space:]]|[^[:space:]]+[[:space:]]+(?:http://[[]::1[]]:@BACKEND_PORT@/|/(?:balancer|socket)/))#"
    </Proxy>
    <Proxy "balancer://fuzzcluster">
        BalancerMember "http://[::1]:@BACKEND_PORT@" route=one
        ProxySet lbmethod=byrequests
    </Proxy>
    ProxyPass /balancer/ balancer://fuzzcluster/
    ProxyPass /socket/ "ws://[::1]:@BACKEND_PORT@/"
    <VirtualHost [::1]:@BACKEND_PORT@>
        DocumentRoot "@RUN_DIR@/htdocs"
    </VirtualHost>
</IfDefine>

<IfDefine FUZZ_CONFIG_11>
    CacheRoot "@RUN_DIR@/logs/cache"
    CacheEnable disk /
    CacheSocache shmcb
    CacheSocacheMaxSize 1048576
    <Location /socache/>
        CacheEnable socache
    </Location>
    CacheDirLevels 3
    CacheDirLength 2
    CacheQuickHandler Off
    ExpiresActive On
    ExpiresDefault "access plus 5 seconds"
    FileETag All
    CacheFile "@RUN_DIR@/htdocs/index.txt"
</IfDefine>

<IfDefine FUZZ_CONFIG_12>
    Protocols h2c http/1.1
    H2Direct On
    H2MaxSessionStreams 32
    H2StreamMaxMemSize 65536
    H2Push On
    H2PushDiarySize 16
    H2EarlyHints On
    H2WebSockets On
    <Location /h2-push>
        H2PushResource add /index.txt critical
    </Location>
</IfDefine>

<IfDefine FUZZ_CONFIG_13>
    SSLEngine On
    SSLCertificateFile "@RUN_DIR@/conf/server.crt"
    SSLCertificateKeyFile "@RUN_DIR@/conf/server.key"
    SSLProtocol all -SSLv3
    SSLCipherSuite ALL:@SECLEVEL=0
    Protocols h2 http/1.1
</IfDefine>

<IfDefine FUZZ_CONFIG_14>
    <Directory "@RUN_DIR@/htdocs">
        Options +Indexes +MultiViews
        CheckSpelling On
    </Directory>
    AddLanguage en .en
    AddLanguage fr .fr
    LanguagePriority en fr
    ForceLanguagePriority Prefer Fallback
    IndexOptions FancyIndexing HTMLTable VersionSort
</IfDefine>

<IfDefine FUZZ_CONFIG_15>
    Header set Accept-Ranges bytes
    ExpiresActive On
    ExpiresByType text/plain "access plus 1 minute"
    SetEnvIf Range .+ has-range
    SetEnvIf If-Range .+ has-if-range
    SetEnvIf If-None-Match .+ has-if-none-match
</IfDefine>

<IfDefine FUZZ_CONFIG_16>
    ScriptAlias /cgi-bin/ "@RUN_DIR@/cgi-bin/"
    <Directory "@RUN_DIR@/cgi-bin">
        Options +ExecCGI
        AcceptPathInfo On
        CGIPassAuth On
        CGIVar REQUEST_URI current-uri
        Require all granted
    </Directory>
    AddHandler cgi-script .cgi
    Action fuzz-handler /cgi-bin/echo.cgi
    AddHandler fuzz-handler .fuzz
    AddType text/html .shtml
    AddOutputFilter INCLUDES .shtml
    XBitHack Full
</IfDefine>

<IfDefine FUZZ_CONFIG_17>
    ExtendedStatus On
    <Location /server-status>
        SetHandler server-status
        Require all granted
    </Location>
    <Location /server-info>
        SetHandler server-info
        Require all granted
    </Location>
    <Location /reflect>
        SetHandler reflector
    </Location>
</IfDefine>

<IfDefine FUZZ_CONFIG_18>
    Protocols h2c http/1.1
    H2Direct On
    H2MaxSessionStreams 100
    H2WindowSize 65535
    H2StreamMaxMemSize 262144
    H2Push On
    H2PushDiarySize 32
    H2EarlyHints On
    H2WebSockets On
    <Location /h2-push>
        H2PushResource add /index.txt critical
    </Location>
</IfDefine>

<IfDefine FUZZ_CONFIG_19>
    HttpProtocolOptions Unsafe LenientMethods Allow0.9
    RewriteEngine On
    RewriteRule ^/dav-alias/(.*)$ /dav/$1 [PT]
    DavLockDB "@RUN_DIR@/logs/DavLock"
    Alias /dav "@RUN_DIR@/htdocs/dav"
    <Directory "@RUN_DIR@/htdocs/dav">
        Dav On
        Require all granted
    </Directory>
    ScriptAlias /cgi-bin/ "@RUN_DIR@/cgi-bin/"
    <Directory "@RUN_DIR@/cgi-bin">
        Options +ExecCGI
        AcceptPathInfo On
        CGIPassAuth On
        CGIVar REQUEST_URI current-uri
        Require all granted
    </Directory>
    AddHandler cgi-script .cgi
    AddType text/html .shtml
    AddOutputFilter INCLUDES .shtml
    XBitHack Full
</IfDefine>

<IfDefine FUZZ_CONFIG_20>
    Listen [::1]:@BACKEND_PORT@
    HttpProtocolOptions Unsafe LenientMethods Require1.0
    Protocols h2c http/1.1
    H2Direct On
    RewriteEngine On
    RewriteRule ^/api/(.*)$ /backend/$1 [PT,E=FUZZ_API:1]
    Header always set X-Fuzz-Config "combined"
    AddOutputFilterByType DEFLATE text/plain text/html application/json
    CacheRoot "@RUN_DIR@/logs/cache"
    CacheEnable disk /
    CacheQuickHandler Off
    ProxyRequests Off
    ProxyTimeout 1
    ProxyPass /combined-proxy/ http://[::1]:@BACKEND_PORT@/
    ProxyPass /proxy-ajp/ ajp://[::1]:@BACKEND_PORT@/
    ProxyPass /proxy-fcgi/ fcgi://[::1]:@BACKEND_PORT@/
    ProxyPass /proxy-scgi/ scgi://[::1]:@BACKEND_PORT@/
    ProxyPass /proxy-uwsgi/ uwsgi://[::1]:@BACKEND_PORT@/
    <VirtualHost [::1]:@BACKEND_PORT@>
        DocumentRoot "@RUN_DIR@/htdocs"
    </VirtualHost>
</IfDefine>

<IfDefine FUZZ_CONFIG_21>
    <Location /auth/anon>
        AuthType Basic
        AuthName "fuzz-anon"
        AuthBasicProvider anon
        Anonymous anonymous ftp
        Anonymous_MustGiveEmail On
        Anonymous_VerifyEmail On
        Anonymous_LogEmail Off
        Require valid-user
    </Location>
    <Location /auth/group>
        AuthType Basic
        AuthName "fuzz-group"
        AuthBasicProvider file
        AuthUserFile "@RUN_DIR@/conf/users"
        AuthGroupFile "@RUN_DIR@/conf/groups"
        Require group fuzzers
    </Location>
    <Location /auth/owner>
        AuthType Basic
        AuthName "fuzz-owner"
        AuthBasicProvider file
        AuthUserFile "@RUN_DIR@/conf/users"
        Require file-owner
    </Location>
</IfDefine>

<IfDefine FUZZ_CONFIG_22>
    <Location /buffer>
        SetHandler reflector
        SetInputFilter BUFFER
        SetOutputFilter BUFFER
        BufferSize 32
        KeptBodySize 65536
        ReflectorHeader X-Fuzz-Reflect X-Fuzz-Echo
    </Location>
    <Location /rate>
        SetOutputFilter RATE_LIMIT
        SetEnv rate-limit 1048576
        SetEnv rate-initial-burst 4096
    </Location>
</IfDefine>

<IfDefine FUZZ_CONFIG_23>
    ExtFilterDefine fuzz-in mode=input intype=application/octet-stream cmd="@RUN_DIR@/conf/filter.sh"
    ExtFilterDefine fuzz-out mode=output outtype=application/octet-stream cmd="@RUN_DIR@/conf/filter.sh"
    <Location /ext/in>
        SetHandler reflector
        SetInputFilter fuzz-in
        ExtFilterOptions LogStderr Onfail=abort
    </Location>
    <Location /ext/out>
        SetOutputFilter fuzz-out
        ExtFilterOptions LogStderr Onfail=remove
    </Location>
</IfDefine>

<IfDefine FUZZ_CONFIG_24>
    <VirtualHost [::1]:@PORT@>
        ServerName dynamic.fuzz.test
        ServerAlias *.vhost.fuzz.test
        VirtualDocumentRoot "@RUN_DIR@/vhosts/%0/htdocs"
        <Directory "@RUN_DIR@/vhosts">
            Require all granted
        </Directory>
    </VirtualHost>
    <VirtualHost [::1]:@PORT@>
        ServerName users.fuzz.test
        UserDir "@RUN_DIR@/userdirs/*"
        <Directory "@RUN_DIR@/userdirs">
            Require all granted
        </Directory>
    </VirtualHost>
</IfDefine>

<IfDefine FUZZ_CONFIG_25>
    RewriteEngine On
    RewriteMap fuzz_txt "txt:@RUN_DIR@/conf/rewrite-map.txt"
    RewriteMap fuzz_dbm "dbm=sdbm:@RUN_DIR@/conf/rewrite-map.dbm"
    RewriteMap fuzz_lower "int:tolower"
    RewriteMap fuzz_escape "int:escape"
    RewriteRule "^/map/txt/([^/]*)$" "${fuzz_txt:$1|/mapped/miss.txt}" [END]
    RewriteRule "^/map/dbm/([^/]*)$" "${fuzz_dbm:$1|/mapped/miss.txt}" [END]
    RewriteRule "^/map/int/(.*)$" "/mapped/${fuzz_lower:$1}" [END,NE]
    RewriteRule "^/map/escape/(.*)$" "/mapped/${fuzz_escape:$1}" [END]
</IfDefine>

<IfDefine FUZZ_CONFIG_26>
    Listen [::1]:@BACKEND_PORT@
    <VirtualHost [::1]:@PORT@>
        ServerName express.fuzz.test
        ServerAlias *.express.fuzz.test
        ProxyRequests Off
        ProxyExpressEnable On
        ProxyExpressDBMFile "@RUN_DIR@/conf/express-map.dbm"
        ProxyExpressDBMType sdbm
    </VirtualHost>
    <VirtualHost [::1]:@BACKEND_PORT@>
        ServerName backend.express.fuzz.test
        DocumentRoot "@RUN_DIR@/htdocs/backend"
    </VirtualHost>
</IfDefine>

<IfDefine FUZZ_CONFIG_27>
    Listen [::1]:@BACKEND_PORT@
    Listen [::1]:@BACKEND2_PORT@
    ProxyRequests Off
    <Proxy "balancer://traffic">
        BalancerMember "http://[::1]:@BACKEND_PORT@" route=one
        BalancerMember "http://[::1]:@BACKEND2_PORT@" route=two
        ProxySet lbmethod=bytraffic stickysession=FUZZROUTE
    </Proxy>
    <Proxy "balancer://busy">
        BalancerMember "http://[::1]:@BACKEND_PORT@" route=one
        BalancerMember "http://[::1]:@BACKEND2_PORT@" route=two
        ProxySet lbmethod=bybusyness
    </Proxy>
    <Proxy "balancer://managed">
        BalancerMember "http://[::1]:@BACKEND_PORT@" route=one
        BalancerMember "http://[::1]:@BACKEND2_PORT@" route=two
        ProxySet nonce=fuzz
    </Proxy>
    ProxyPass /traffic/ balancer://traffic/
    ProxyPass /busy/ balancer://busy/
    <Location /balancer-manager>
        SetHandler balancer-manager
        Require all granted
    </Location>
    <VirtualHost [::1]:@BACKEND_PORT@>
        DocumentRoot "@RUN_DIR@/htdocs/backend"
    </VirtualHost>
    <VirtualHost [::1]:@BACKEND2_PORT@>
        DocumentRoot "@RUN_DIR@/htdocs/backend"
    </VirtualHost>
</IfDefine>

<IfDefine FUZZ_CONFIG_28>
    ErrorDocument 400 /errors/400.shtml
    ErrorDocument 404 /errors/404.shtml
    ErrorDocument 405 /errors/405.shtml
    AddOutputFilter INCLUDES .shtml
    Alias /errors/ "@RUN_DIR@/htdocs/errors/"
    Alias /fallback-zone/ "@RUN_DIR@/htdocs/fallback-zone/"
    <Directory "@RUN_DIR@/htdocs/errors">
        Options Includes
        Require all granted
    </Directory>
    <Directory "@RUN_DIR@/htdocs/fallback-zone">
        FallbackResource /fallback.shtml
        DirectoryIndex index.shtml
        DirectoryIndexRedirect 307
        AcceptPathInfo On
        Options Includes
        Require all granted
    </Directory>
</IfDefine>

<IfDefine FUZZ_CONFIG_29>
    CacheRoot "@RUN_DIR@/logs/cache-policy"
    CacheEnable disk /cache-policy/
    CacheQuickHandler On
    CacheLock On
    CacheLockPath "@RUN_DIR@/logs/cache-lock"
    CacheLockMaxAge 1
    CacheHeader On
    CacheDetailHeader On
    CacheIgnoreCacheControl On
    CacheStorePrivate On
    CacheStoreNoStore On
    CacheIgnoreHeaders Set-Cookie
    CacheIgnoreQueryString On
    ExpiresActive On
    ExpiresDefault "access plus 5 seconds"
</IfDefine>

<IfDefine FUZZ_CONFIG_30>
    Listen [::1]:@BACKEND_PORT@
    <VirtualHost [::1]:@PORT@>
        ServerName frontend.fuzz.test
        ProxyRequests Off
        ProxyPass /response/ http://[::1]:@BACKEND_PORT@/
        ProxyPassReverse /response/ http://[::1]:@BACKEND_PORT@/
        ProxyPassReverseCookieDomain backend.fuzz.test frontend.fuzz.test
        ProxyPassReverseCookiePath /backend/ /response/
        ProxyErrorOverride On 404 500 503
    </VirtualHost>
    <VirtualHost [::1]:@BACKEND_PORT@>
        ServerName backend.fuzz.test
        DocumentRoot "@RUN_DIR@/htdocs/backend-response"
        Header always set Set-Cookie "id=fuzz; Path=/backend/; Domain=backend.fuzz.test"
        Redirect 302 /redirect http://[::1]:@BACKEND_PORT@/destination/
        RewriteEngine On
        RewriteRule ^/error/(.*)$ - [R=503,L]
    </VirtualHost>
</IfDefine>

<IfDefine FUZZ_CONFIG_31>
    <Location /data/>
        SetOutputFilter DATA
    </Location>
    AddHandler imap-file .map
    <Files "shapes.map">
        ImapMenu formatted
        ImapDefault menu
        ImapBase map
    </Files>
</IfDefine>

<IfDefine FUZZ_CONFIG_32>
    <Location /charset>
        SetHandler reflector
        CharsetSourceEnc ISO-8859-1
        CharsetDefault UTF-8
        CharsetOptions TranslateAllMimeTypes
    </Location>
</IfDefine>

<IfDefine FUZZ_CONFIG_33>
    Listen [::1]:@BACKEND_PORT@
    SSLSessionCache "dbm:@RUN_DIR@/logs/tls-socache"
    SSLSessionCacheTimeout 30
    <VirtualHost [::1]:@PORT@>
        ServerName tls-proxy.fuzz.test
        SSLProxyEngine On
        SSLProxyVerify none
        SSLProxyCheckPeerName Off
        SSLProxyCheckPeerExpire Off
        SSLProxyProtocol all -SSLv3
        ProxyPass /tls-backend/ https://[::1]:@BACKEND_PORT@/ disablereuse=On connectiontimeout=1 timeout=1
        ProxyPassReverse /tls-backend/ https://[::1]:@BACKEND_PORT@/
    </VirtualHost>
    <VirtualHost [::1]:@BACKEND_PORT@>
        ServerName tls-backend.fuzz.test
        DocumentRoot "@RUN_DIR@/htdocs"
        SSLEngine On
        SSLCertificateFile "@RUN_DIR@/conf/server.crt"
        SSLCertificateKeyFile "@RUN_DIR@/conf/server.key"
        SSLProtocol all -SSLv3
        SSLCipherSuite ALL:@SECLEVEL=0
        Protocols h2 http/1.1
    </VirtualHost>
</IfDefine>

<IfDefine FUZZ_CONFIG_34>
    CacheSocache "dbm:@RUN_DIR@/logs/cache-socache"
    CacheSocacheMaxSize 1048576
    CacheSocacheMaxTime 60
    CacheSocacheMinTime 1
    CacheSocacheReadSize 32
    CacheSocacheReadTime 1
    CacheEnable socache /socache/
    CacheQuickHandler Off
    ExpiresActive On
    ExpiresDefault "access plus 5 seconds"
    FileETag All
</IfDefine>

<IfDefine FUZZ_CONFIG_35>
    RemoteIPProxyProtocol On
</IfDefine>
